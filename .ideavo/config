{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "npm ci"
    }
  ],
  "codeChecks": [
    {
      "name": "Run Lint Check",
      "command": "npm run lint"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "npm run build"
    },
    {
      "name": "Build Android APK",
      "command": "npm run android:build"
    }
  ],
  "runStep": [
    {
      "name": "Run Dev Server",
      "command": "npm run dev -- --host 0.0.0.0 --port 3000",
      "port": "3000"
    }
  ],
  "deploySteps": [
    {
      "name": "Build for Deployment",
      "command": "npm run build"
    }
  ],
  "cleanupFiles": [
    "node_modules",
    "dist",
    "build"
  ],
  "packageManager": "npm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
